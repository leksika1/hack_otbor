# Copy to .env and fill in. Never commit a real key.

# --- LLM provider (any OpenAI-compatible endpoint) -----------------------
# Leave LLM_API_KEY empty to run fully offline on the deterministic mock
# provider. The API always reports which provider produced the explanations.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- LLM behaviour -------------------------------------------------------
# true  -> a failed LLM call is silently replaced by mock text (dev only)
# false -> failures are reported instead of being masked (default)
LLM_FALLBACK_TO_MOCK=false
# How many of the most significant issues are sent to the LLM per session.
LLM_MAX_ISSUES=5
# Steps included around each flagged step in the context fragment.
LLM_CONTEXT_RADIUS=2
# Parallel LLM requests.
LLM_CONCURRENCY=4

# --- API -----------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
