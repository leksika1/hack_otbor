# Copy to .env and fill in. Never commit a real key.
# Every value has a working default: without an API key the service runs
# offline on the deterministic mock provider.

# --- LLM provider (any OpenAI-compatible endpoint) --------------------------
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# --- LLM behaviour ----------------------------------------------------------
# true  -> a failed LLM call is silently replaced by mock text (development only)
# false -> failures are reported instead of being masked (default)
LLM_FALLBACK_TO_MOCK=false
# How many of the most significant issues are explained per session.
LLM_MAX_ISSUES=5
# Steps included around each flagged step in the context fragment.
LLM_CONTEXT_RADIUS=2
# Parallel LLM requests.
LLM_CONCURRENCY=4

# --- API --------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_STEPS_IN_RESPONSE=500
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
